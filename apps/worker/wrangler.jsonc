{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "al-fatina",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Storefront (pre-rendered pages) + admin SPA, assembled by scripts/assemble-dist.mjs.
  // Static files are served free and never count against the Worker request/CPU limits.
  // Only these paths run the Worker first:
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/robots.txt",
      "/sitemap.xml",
      "/feeds/*",
      "/api/*",
      "/admin",
      "/admin/*",
      "/media/*",
      "/l/*",
      "/produit/*",
      "/c/*",
      "/p/*",
      "/collection/*",
      "/fr/produit/*",
      "/fr/c/*",
      "/fr/p/*",
      "/fr/collection/*"
    ]
  },
  // No custom domain yet: the shop answers on its workers.dev address. With a domain, add
  // "routes": [{ "pattern": "example.dz", "custom_domain": true }] and set PUBLIC_ORIGIN.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-fatina-db",
      // Al Fatina's own database (created 2026-10-13, location weur). Never another shop's id.
      "database_id": "808962b0-3ca1-499b-81e8-70b83507adb3",
      // Local development keeps its own database (npm run dev), never the production one: this
      // id only names the local copy (.wrangler/state). Query it from the repo root with
      // `npm run db:sql:local -- "SELECT …"` (the team table is team_members).
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "el-fatina-media"
    }
  ],
  // Live admin (new orders, alerts) over WebSockets. SQLite-backed Durable Objects are on the
  // free plan; hibernation keeps idle admin tabs at zero cost.
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "AdminHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AdminHub"
      ]
    }
  ],
  // namespace ids are shared by every Worker of the Cloudflare account: Henine uses 1001-1006,
  // Al Fatina 2001-2006 (the same ids would make both shops count against one limit)
  "ratelimits": [
    {
      "name": "RL_WRITE",
      "namespace_id": "2001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_LOOKUP",
      "namespace_id": "2002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "RL_AUTH",
      "namespace_id": "2003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      // shop-wide (not per visitor) budget of database writes from counters: visits, error
      // reports, saved checkouts. Past it they are skipped: the daily D1 write quota stays for orders
      "name": "RL_BEACON",
      "namespace_id": "2005",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      // each visitor's own share of those counters, checked first: one script can no longer
      // empty the shop-wide budget for everyone (a real visit sends a few per minute)
      "name": "RL_BEACON_IP",
      "namespace_id": "2006",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_AI",
      "namespace_id": "2004",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  // Workers AI: the shop assistant's voice (free daily allocation; when it is used up the
  // assistant answers with its rules alone, nothing is billed on the free plan)
  "ai": {
    "binding": "AI"
  },
  // Cloudflare Images: product photos without background, all framed alike (5,000 free a
  // month; beyond that the photo is kept as it is, nothing is billed on the free plan)
  "images": {
    "binding": "IMAGES"
  },
  // one trigger: the account's free plan allows 5 and Henine uses 3. src/scheduled.ts picks the
  // work from the time (21:00 Algiers = 20:00 UTC, Algeria has no DST)
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://al-fatina.karimmaticmz.workers.dev",
    "MEDIA_ORIGIN": "",
    // "console": no email service, admins sign in with an authenticator app
    "MAIL_PROVIDER": "console",
    "MAIL_FROM": "Al Fatina <no-reply@example.com>",
    // "off" = assistant without AI
    "ASSISTANT_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  },
  // Workers Logs: every request is kept (3 days), so a customer's failed order can always be
  // found. The free plan includes 200,000 log lines a day, far above this shop's traffic; past
  // that, logs are dropped for the day, never billed.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}